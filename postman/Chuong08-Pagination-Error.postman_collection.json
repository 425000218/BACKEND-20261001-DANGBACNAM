    {
      "name": "P01 - GET Danh Sách Mặc Định (page=1, limit=10)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"P01: HTTP 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var res = pm.response.json();",
              "pm.test(\"P01: data là mảng và có pagination mặc định\", function () {",
              "    pm.expect(Array.isArray(res.data)).to.be.true;",
              "    pm.expect(res.pagination.page).to.eql(1);",
              "    pm.expect(res.pagination.limit).to.eql(10);",
              "    pm.expect(res.pagination.totalItems).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/v1/sinh-vien",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "sinh-vien"]
