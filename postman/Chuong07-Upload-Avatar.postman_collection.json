{
  "info": {
    "_postman_id": "a90b40e7-380d-40e9-b591-upload07lab01",
    "name": "Chuong07-Upload-Avatar-Lab",
    "description": "Bộ kịch bản kiểm thử Postman cho Chương 07: Upload Ảnh Đại Diện & Kiểm soát An toàn File (Multer, Magic Bytes, RBAC)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "studentToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Tiền đề - Đăng nhập Student lấy Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.data && jsonData.data.accessToken) {",
              "    pm.collectionVariables.set(\"studentToken\", jsonData.data.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"an.lab@example.com\",\n  \"password\": \"SinhVien@123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "U01 - Upload Avatar PNG hợp lệ (200 OK)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{studentToken}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "avatar",
              "type": "file",
              "src": "docs/screenshots/avatar-valid.png",
              "description": "File ảnh PNG hợp lệ <= 2MB"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/me/avatar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me", "avatar"]
        }
      }
    },
    {
      "name": "U02 - Upload Avatar JPEG hợp lệ (200 OK)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{studentToken}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "avatar",
              "type": "file",
              "src": "docs/screenshots/avatar-valid.jpg",
              "description": "File ảnh JPEG hợp lệ <= 2MB"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/me/avatar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me", "avatar"]
        }
      }
    },
    {
      "name": "U03 - Thiếu Authorization Header (401 Unauthorized)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "avatar",
              "type": "file",
              "src": "docs/screenshots/avatar-valid.png"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/me/avatar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me", "avatar"]
        }
      }
    },
    {
      "name": "U04 - JWT không hợp lệ hoặc hết hạn (401 Unauthorized)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "invalid.or.expired.jwt.token", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "avatar",
              "type": "file",
              "src": "docs/screenshots/avatar-valid.png"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/me/avatar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me", "avatar"]
        }
      }
    },
    {
