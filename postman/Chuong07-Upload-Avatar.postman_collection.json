    },
    {
      "name": "U11 - Client gửi userId trong body - Server chỉ dùng JWT (200 OK)",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{studentToken}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "avatar", "type": "file", "src": "docs/screenshots/avatar-valid.png" },
            { "key": "userId", "value": "999", "type": "text" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/me/avatar",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me", "avatar"]
        }
      }
    },
    {
      "name": "U12 - GET Profile xác minh avatarUrl & kiểm tra file tĩnh (200 OK)",
      "request": {
        "auth": {
